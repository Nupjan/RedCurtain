<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FF4081" <!-- Pinkish-Red -->
    android:endColor="#673AB7"    <!-- Deep Purple -->
    android:angle="270" />        <!-- Gradient direction (270 for top-to-bottom) -->
    <corners android:radius="12dp" /> <!-- Larger radius for date boxes -->
    <padding
        android:left="10dp"
        android:top="5dp"
        android:right="10dp"
        android:bottom="5dp"/>
</shape>
