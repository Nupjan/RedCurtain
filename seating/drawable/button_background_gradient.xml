<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Define the gradient -->
    <gradient
        android:startColor="#FF4081"  <!-- Pinkish-Red -->
    android:endColor="#673AB7"    <!-- Deep Purple -->
    android:angle="90" />         <!-- Gradient direction (90 for vertical) -->

    <!-- Define the corners -->
    <corners android:radius="30dp" /> <!-- Adjust radius for desired roundness -->

    <!-- Optional: Add padding inside the button if needed -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>

</shape>
